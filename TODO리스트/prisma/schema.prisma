generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 중요도 3단계. SQLite에서는 TEXT로 저장된다(002 R-101).
enum Priority {
  HIGH
  MEDIUM
  LOW
}

/// 스펙의 "할 일(Todo)"에 대응하는 모델. 매핑은 specs/001-todo-management/data-model.md 참고.
model Task {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  priority  Priority @default(MEDIUM)
  createdAt DateTime @default(now())
}
